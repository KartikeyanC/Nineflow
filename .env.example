# Copy this file to .env.local and fill in at least one sign-in method.

# Google sign-in + Drive storage. See docs/GOOGLE_SETUP.md for how to get the client ID.
VITE_GOOGLE_CLIENT_ID=

# Email + password accounts (Supabase). See docs/SUPABASE_SETUP.md.
# Project URL, and the publishable key (or the legacy "anon" key). Both are safe in the browser:
# row-level security keeps each person to their own data. Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Development only (ignored by production builds): try sign-in without real projects.
# VITE_GOOGLE_MOCK=1
# VITE_SUPABASE_MOCK=1

# "Prompt to list" (turns a note into tasks with Claude). Server-side only: no VITE_ prefix, so it
# never reaches the browser. Create the key at console.anthropic.com, then set it here and in
# Vercel > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Used by: Prompt to list, Meeting notes, Auto-fill and Ask NineFlow (the api/ folder).
# Optional: ANTHROPIC_MODEL=claude-haiku-5-5
# Desktop app only: the deployed site that hosts /api (for example https://your-app.vercel.app).
# VITE_API_BASE=

# Reminders while NineFlow is closed, on the website (see docs/REMINDERS.md). Generate keys with:
#   npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# REMINDER_SECRET=          (any long random string)
# QSTASH_TOKEN=             (console.upstash.com > QStash)
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=               (only if Upstash shows a regional URL)
# APP_URL=                  (optional; defaults to the Vercel production address)

# Email to NineFlow: mail sent to a private address becomes a task (see docs/EMAIL.md).
# VITE_INBOX_ADDRESS=        (Postmark > Server > Inbound address, e.g. abc123@inbound.postmarkapp.com)
# INBOUND_WEBHOOK_PASSWORD=  (any long random string; also put it in Postmark's webhook URL)
# INBOUND_WEBHOOK_USER=      (optional; default "postmark")
# UPSTASH_REDIS_REST_URL=    (console.upstash.com > Redis > REST API)
# UPSTASH_REDIS_REST_TOKEN=

# More connections (see docs/CONNECTIONS_SETUP.md). All optional: each button simply stays hidden until its value is set.
# Attach files from Google Drive (the Picker): an API key limited to the Picker API and this site, and the project number.
# VITE_GOOGLE_API_KEY=
# VITE_GOOGLE_APP_ID=
# Microsoft Outlook Calendar and To Do: the Application (client) ID of an Azure app registration (SPA redirect <site>/ms-callback.html).
# VITE_MS_CLIENT_ID=
# VITE_MS_TENANT=            (optional: common (default), organizations or consumers)
# The calendar subscription link uses the same Upstash Redis variables as Email to NineFlow, above.

# Security (see docs/SECURITY.md). All optional.
# ALLOWED_ORIGINS=           (extra sites allowed to call the API, comma-separated; the site itself and the desktop app always are)
# AI_DAILY_LIMIT=2000        (all AI requests together per day, across every visitor: a cost ceiling)
# LOG_SALT=                  (any random string; salts the IP hash in security logs)
