# Copy this file to .env.local and fill in at least one sign-in method.

# Google sign-in + Drive storage. See docs/GOOGLE_SETUP.md for how to get the client ID.
VITE_GOOGLE_CLIENT_ID=

# Email + password accounts (Supabase). See docs/SUPABASE_SETUP.md.
# Project URL, and the publishable key (or the legacy "anon" key). Both are safe in the browser:
# row-level security keeps each person to their own data. Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Development only (ignored by production builds): try sign-in without real projects.
# VITE_GOOGLE_MOCK=1
# VITE_SUPABASE_MOCK=1
