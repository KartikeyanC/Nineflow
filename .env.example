# Copy this file to .env.local and fill in at least one sign-in method.

# Google sign-in + Drive storage. See docs/GOOGLE_SETUP.md for how to get the client ID.
VITE_GOOGLE_CLIENT_ID=

# Email + password accounts (Supabase). See docs/SUPABASE_SETUP.md.
# Project URL, and the publishable key (or the legacy "anon" key). Both are safe in the browser:
# row-level security keeps each person to their own data. Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Development only (ignored by production builds): try sign-in without real projects.
# VITE_GOOGLE_MOCK=1
# VITE_SUPABASE_MOCK=1

# "Prompt to list" (turns a note into tasks with Claude). Server-side only: no VITE_ prefix, so it
# never reaches the browser. Create the key at console.anthropic.com, then set it here and in
# Vercel > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Used by: Prompt to list, Meeting notes, Auto-fill and Ask NineFlow (the api/ folder).
# Optional: ANTHROPIC_MODEL=claude-haiku-5-5
# Desktop app only: the deployed site that hosts /api (for example https://your-app.vercel.app).
# VITE_API_BASE=
