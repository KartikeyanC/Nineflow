{
  "name": "daily-planner",
  "private": true,
  "version": "0.1.45",
  "description": "NineFlow: plan better, flow forward.",
  "author": "Kartikeyan",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:win": "vite build && node scripts/minify-desktop.mjs && electron-builder --win",
    "desktop:mac": "vite build && node scripts/minify-desktop.mjs && electron-builder --mac",
    "postbuild": "node scripts/security-headers.mjs",
    "android:sync": "vite build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:test": "rolldown -c scripts/android-bridge-test/rolldown.config.mjs && node node_modules/.cache/android-bridge-test.mjs",
    "test:ntpc": "rolldown -c scripts/ntpc-test/rolldown.config.mjs && node node_modules/.cache/ntpc-test.mjs",
    "test:voice": "rolldown -c scripts/voice-test/rolldown.config.mjs && node node_modules/.cache/voice-test.mjs",
    "test:history": "node scripts/history-test.mjs",
    "test:e2e": "playwright test",
    "test:transfer": "rolldown -c scripts/transfer-test/rolldown.config.mjs && node node_modules/.cache/transfer-test.mjs",
    "test:import": "rolldown -c scripts/import-test/rolldown.config.mjs && node node_modules/.cache/import-test.mjs",
    "test:billing": "node scripts/billing-test.mjs",
    "test:fields": "node scripts/fields-test.mjs",
    "test:profession": "node scripts/profession-test.mjs",
    "licence": "node scripts/licence.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@noble/ed25519": "^3.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "vite": "^8.3.3"
  },
  "license": "UNLICENSED"
}
