{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "dev-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "env": {
        "VITE_GOOGLE_MOCK": "1",
        "VITE_GOOGLE_CLIENT_ID": ""
      },
      "port": 5180
    },
    {
      "name": "dev-mock-auto",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite"
      ],
      "env": {
        "VITE_GOOGLE_MOCK": "1",
        "VITE_GOOGLE_CLIENT_ID": ""
      },
      "port": 5181,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "dist-headers",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-dist.mjs"
      ],
      "port": 4175
    },
    {
      "name": "dev-supabase-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5182",
        "--strictPort"
      ],
      "env": {
        "VITE_SUPABASE_MOCK": "1",
        "VITE_GOOGLE_CLIENT_ID": ""
      },
      "port": 5182
    },
    {
      "name": "profession-todo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "F:/Movie/profession-todo",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
